{
  // Caffe Aroma pitch site. Static export in ./out + a tiny Worker (worker/index.js). Deploy with: npm run deploy:cf
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caffe-aroma",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "caffearoma.cwmccann.pro", "custom_domain": true }],
  "observability": { "enabled": true }
}
